classDiagram
    class User {
        +int Id
        +Username Username
        +Password PasswordHash
        +uint HighScoreWpm
        +uint GamesPlayed
        +uint GamesWin
    }
    class Username {
        +string Value
    }
    class Password {
        +string Value
    }
    User --> "1" Username : Username
    User --> "1" Password : PasswordHash
    class User:::core
    class Username:::core
    class Password:::core

    classDef client fill:#FFEDD5,stroke:#EA580C,stroke-width:2px,color:#7C2D12
    classDef proxy  fill:#E2E8F0,stroke:#475569,stroke-width:2px,color:#0F172A
    classDef api    fill:#E0E7FF,stroke:#4F46E5,stroke-width:2px,color:#1E1B4B
    classDef core   fill:#D1FAE5,stroke:#059669,stroke-width:2px,color:#064E3B
    classDef infra  fill:#E0F2FE,stroke:#0284C7,stroke-width:2px,color:#0C4A6E
    classDef db     fill:#F3E8FF,stroke:#9333EA,stroke-width:2px,color:#581C87
